dist/
build/
*.min.js
*.min.css

# Archivos de Git
.git/
.gitignore
.gitattributes

# Archivos de Docker
Dockerfile
.dockerignore
docker-compose.yml

# Archivos de documentación
README.md
*.md
docs/

# Archivos de entorno
.env
.env.local
.env.*.local

# Archivos de logs
*.log
logs/

# Archivos temporales
tmp/
temp/
*.tmp

# Archivos de backup
*.bak
*.backup
*~

